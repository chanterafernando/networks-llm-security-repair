+def parse_rc(stdout: str, marker: str) -> Optional[int]:
+    for line in stdout.splitlines():
+        if marker in line:
+            try:
+                return int(line.split(marker, 1)[1].strip().split()[0])
+            except Exception:
+                continue
+    return None
